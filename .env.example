# ========================================================
# ShopMart - Bilingual (English + Kannada) Retail Engine
# Aiven Hackathon Environment Configuration Template
# ========================================================

# Application Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_shopmart_jwt_key_aiven_hackathon_2024_change_in_prod
JWT_EXPIRES_IN=7d

# --------------------------------------------------------
# 1. Aiven PostgreSQL Configuration
# --------------------------------------------------------
# Connection string format:
# postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PG_PASSWORD@YOUR_AIVEN_PG_HOST.aivencloud.com:PORT/defaultdb?sslmode=require
PG_SSL_REJECT_UNAUTHORIZED=false

# --------------------------------------------------------
# 2. Aiven Apache Kafka Configuration
# --------------------------------------------------------
# Comma-separated list of broker endpoints:
KAFKA_BROKERS=YOUR_AIVEN_KAFKA_HOST.aivencloud.com:PORT
KAFKA_CLIENT_ID=shopmart-retail-engine
KAFKA_GROUP_ID=shopmart-consumer-group

# Authentication type: "SSL" (using certs) or "SASL" (username/password) or "NONE"
KAFKA_AUTH_TYPE=SSL

# If KAFKA_AUTH_TYPE=SSL (Certificates downloaded from Aiven console to certs/ directory):
KAFKA_CA_CERT_PATH=./certs/ca.pem
KAFKA_ACCESS_CERT_PATH=./certs/service.cert
KAFKA_ACCESS_KEY_PATH=./certs/service.key

# If KAFKA_AUTH_TYPE=SASL:
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=YOUR_KAFKA_PASSWORD

# Kafka Topics
KAFKA_TOPIC_ORDER_PLACED=order.placed
KAFKA_TOPIC_INVENTORY_CHANGED=inventory.changed
KAFKA_TOPIC_PRODUCT_UPDATED=product.updated
KAFKA_TOPIC_DELIVERY_ASSIGNED=delivery.assigned
KAFKA_TOPIC_DELIVERY_STATUS_CHANGED=delivery.status.changed

# --------------------------------------------------------
# 3. Aiven OpenSearch Configuration
# --------------------------------------------------------
# Connection URI format:
# https://<user>:<password>@<host>:<port>
OPENSEARCH_URL=https://avnadmin:YOUR_AIVEN_OPENSEARCH_PASSWORD@YOUR_AIVEN_OPENSEARCH_HOST.aivencloud.com:PORT
OPENSEARCH_INDEX=shopmart_products
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false

# --------------------------------------------------------
# 4. Instant Delivery & Eco Simulation Settings
# --------------------------------------------------------
# Instant delivery radius in KM
DEFAULT_DELIVERY_RADIUS_KM=5.0
# Base preparation time in minutes
BASE_PREP_TIME_MIN=15
# Time per kilometer in minutes (15 min base + 3 min/km)
MINUTES_PER_KM=3.0

# Delivery CO2 emission factor in kg CO2 per km (two-wheeler / EV delivery)
EMISSION_FACTOR_KG_PER_KM=0.1
# Benchmark personal trip emission factor in kg CO2 per km (car/auto roundtrip)
BENCHMARK_TRIP_FACTOR_KG_PER_KM=0.28

# Simulation Step Timers (Seconds per delivery stage for quick hackathon demo)
# Stages: PLACED -> PACKED -> OUT_FOR_DELIVERY -> DELIVERED
SIMULATION_PACKED_DELAY_SEC=12
SIMULATION_OUTFORDELIVERY_DELAY_SEC=15
SIMULATION_DELIVERED_DELAY_SEC=18

# --------------------------------------------------------
# 5. Fallback & Local Dev Mode
# --------------------------------------------------------
# If set to true, seamlessly emulates Aiven services in-memory if external
# cloud connections are not yet provisioned, allowing instant local testing.
USE_FALLBACK_IF_DISCONNECTED=true
