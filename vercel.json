{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://urban-store-kmct.onrender.com/api/:path*"
    },
    {
      "source": "/events",
      "destination": "https://urban-store-kmct.onrender.com/events"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
